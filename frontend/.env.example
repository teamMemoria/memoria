# Database-backed entry point; backend must explicitly enable development identity.
VITE_API_BASE_URL=/
# No fixed user: every request is bound to the profile selected on the entry screen.
# MEMORIA_API_TARGET=http://127.0.0.1:8022 npm run dev
# For the explicitly public hosted demo, set VITE_PUBLIC_DEMO=true at build time.
# That build lists seeded demo profiles and sends the selected ID as X-Dev-User.
# Set VITE_API_BASE_URL to the backend's HTTPS origin (without /api).
# Leave VITE_PUBLIC_DEMO unset for a normal production build.
