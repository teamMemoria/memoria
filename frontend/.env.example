# Database-backed demo entry point; backend must explicitly enable development identity.
VITE_API_BASE_URL=/
VITE_DEMO_BACKEND=true
# No fixed user: every request is bound to the profile selected on the entry screen.
# MEMORIA_API_TARGET=http://127.0.0.1:8022 npm run dev
# Production uses authenticated cookies and never sends X-Dev-User or lists demo profiles.
